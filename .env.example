# RECON frontend configuration. All three are public (read in the browser); nothing secret exists.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet
NEXT_PUBLIC_GENLAYER_CHAIN=61999
# The deployment of record (docs/deployment.json), byte-verified against contracts/recon.py.
NEXT_PUBLIC_RECON_CONTRACT=0x39C9137F746BfA133Dc04776ffcCF876370D01E8
